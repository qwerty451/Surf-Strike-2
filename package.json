{
	"name": "surf-strike-2",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"check": "pnpm -r check",
		"test": "pnpm -r test",
		"server": "PORT=27016 pnpm --filter server dev",
		"host": "pnpm --filter server host",
		"play": "pnpm --filter server exec tsx ../../tools/dev-launch.ts",
		"play:surf": "pnpm --filter server exec tsx ../../tools/dev-launch.ts surf",
		"play:bhop": "pnpm --filter server exec tsx ../../tools/dev-launch.ts bhop",
		"play:tag": "pnpm --filter server exec tsx ../../tools/dev-launch.ts tag --bots 1 --fast",
		"play:zombies": "pnpm --filter server exec tsx ../../tools/dev-launch.ts zombies --fast",
		"play:infected": "pnpm --filter server exec tsx ../../tools/dev-launch.ts infected --bots 2 --fast",
		"test:mode": "node tools/test-mode.mjs",
		"netprobe": "pnpm --filter netprobe probe"
	}
}
