{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --run --passWithNoTests"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.6",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/three": "^0.187.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource/barlow-semi-condensed": "^5.3.0",
		"@fontsource/rajdhani": "^5.3.0",
		"@surf/shared": "workspace:*",
		"@vercel/functions": "3.11.3",
		"three": "^0.187.0"
	}
}
